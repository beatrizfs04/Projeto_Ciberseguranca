<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="290.0" prefWidth="475.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.app.GerarPasswordController">

    <children>
        <Label alignment="CENTER" contentDisplay="CENTER" layoutX="86.0" layoutY="62.0" prefHeight="31.0" prefWidth="300.0" styleClass="title-label" text="Gerador de Senha Segura">
         <font>
            <Font name="Century" size="20.0" />
         </font></Label>
        <Button layoutX="198.0" layoutY="205.0" mnemonicParsing="false" onAction="#onGeneratePasswordButtonClick" text="Gerar Senha" />
        <Label layoutX="90.0" layoutY="148.0" text="Comprimento da Senha:" />
        <TextField fx:id="lengthTextField" layoutX="251.0" layoutY="145.0" prefHeight="22.0" prefWidth="138.0" />
        <TextArea fx:id="passwordTextArea" editable="false" layoutX="153.0" layoutY="239.0" prefHeight="9.0" prefWidth="300.0" visible="false" />
        <Button fx:id="copyButton" layoutX="278.0" layoutY="287.0" managed="false" mnemonicParsing="false" onAction="#onCopyPasswordButtonClick" text="Copiar" visible="false" />
    </children>
</AnchorPane>
