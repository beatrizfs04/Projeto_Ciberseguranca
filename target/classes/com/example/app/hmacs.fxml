<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="hmacsPane" prefHeight="400.0" prefWidth="600.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.app.hmacsController">
    <children>
        <VBox alignment="CENTER" layoutX="140.0" layoutY="30.0" spacing="20" />
        <Button fx:id="calculateButton" layoutX="252.0" layoutY="212.0" onAction="#calculateHMAC" styleClass="button" text="Calcular HMAC" />
        <TextField fx:id="keyField" layoutX="260.0" layoutY="161.0" prefHeight="22.0" prefWidth="184.0" promptText="Insira a chave (ex: 1A2B3C4D)" styleClass="text-field" />
        <TextField fx:id="fileNameField" layoutX="260.0" layoutY="79.0" prefHeight="22.0" prefWidth="184.0" promptText="Nome do arquivo" styleClass="text-field" />
        <ComboBox fx:id="algorithmComboBox" layoutX="260.0" layoutY="119.0" prefHeight="23.0" prefWidth="184.0" styleClass="combo-box">
            <items>
                <FXCollections fx:factory="observableArrayList">
                </FXCollections>
            </items>
        </ComboBox>
        <Label fx:id="resultLabel" alignment="TOP_LEFT" layoutX="69.0" layoutY="267.0" prefHeight="102.0" prefWidth="462.0" styleClass="result-label" text="Resultado:" wrapText="true">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <Label layoutX="99.0" layoutY="83.0" styleClass="label" text="Arquivo:" />
        <Label layoutX="100.0" layoutY="123.0" styleClass="label" text="Algoritmo a usar:" />
        <Label layoutX="99.0" layoutY="164.0" styleClass="label" text="Chave Hexadecimal:" />
        <Label layoutX="170.0" layoutY="22.0" prefHeight="31.0" prefWidth="260.0" styleClass="title-label" text="Cálculo de HMAC's">
            <font>
                <Font name="Georgia Bold" size="26.0" />
            </font>
        </Label>
    </children>
</AnchorPane>
