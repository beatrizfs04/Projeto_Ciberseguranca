<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="hashPane" prefHeight="452.0" prefWidth="600.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.app.hashController">
   <children>
      <TextField fx:id="nomeText" layoutX="260.0" layoutY="125.0" prefHeight="22.0" prefWidth="184.0" promptText="Nome do ficheiro" styleClass="text-field" />
      <ComboBox fx:id="algorithmComboBox" layoutX="260.0" layoutY="165.0" prefHeight="23.0" prefWidth="184.0" styleClass="combo-box">
         <items>
            <FXCollections fx:factory="observableArrayList">
            </FXCollections>
         </items>
      </ComboBox>
      <Button fx:id="calcularButton" layoutX="256.0" layoutY="226.0" onAction="#calcularHash" styleClass="button" text="Calcular hash" />
      <Label fx:id="resultadoLabel" alignment="TOP_LEFT" layoutX="69.0" layoutY="291.0" prefHeight="102.0" prefWidth="462.0" styleClass="result-label" text="Resultado:" wrapText="true">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <Label layoutX="99.0" layoutY="128.0" styleClass="label" text="Nome do ficheiro:" />
      <Label layoutX="101.0" layoutY="169.0" styleClass="label" text="Algoritmo a usar:" />
      <Label layoutX="195.0" layoutY="58.0" prefHeight="31.0" prefWidth="210.0" styleClass="title-label" text="Cálculo de Hash">
         <font>
            <Font name="Georgia Bold" size="26.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
